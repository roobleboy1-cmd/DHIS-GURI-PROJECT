# ==============================================================================
# GURI DHIS Backend Environment Configuration
# Use these variable names when configuring environment variables on Render
# ==============================================================================

PORT=5001
NODE_ENV=production

# Online Managed PostgreSQL Connection String (from Neon, Supabase, or Render)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host/your_db_name?sslmode=require

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Deployed Frontend Public URL (Vercel or Netlify)
FRONTEND_URL=https://your-app-name.vercel.app

# Cloudinary Cloud Asset Storage (Preserve these exact credentials)
CLOUDINARY_CLOUD_NAME=vzhzosef
CLOUDINARY_API_KEY=442249531596166
CLOUDINARY_API_SECRET=WK0wynWjTBMSymTmx9fPLwFlceI
